# Fine-grained GitHub PAT: public repositories only, no write permissions.
# Never use account passwords. Never place this file in dist/.
GITHUB_TOKEN=
PORT=8080
CACHE_DIR=.cache
TRUST_PROXY=false
APP_ORIGIN=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
POLLINATIONS_API_KEY=
